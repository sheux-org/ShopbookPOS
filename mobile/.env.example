# ==========================================
# Shopbook POS Mobile - Environment Template
# ==========================================
# Copy this file to .env and replace placeholders with your actual credentials.
# Command: cp .env.example .env

# Supabase Project Credentials
# Find these in Supabase Dashboard -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# UploadThing Credentials for Product Image Uploads
# Find your API token at: https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=your-uploadthing-token-here

# Dev Server UploadThing URL (Change to production URL when deploying)
EXPO_PUBLIC_UPLOADTHING_URL=http://localhost:8081

# --- RevenueCat (public SDK keys — safe to ship in the bundle) ---
# From RevenueCat dashboard → Project → API keys → Public SDK keys.
# Leave blank until the RevenueCat project exists: configurePurchases()
# returns false and the paywall shows "coming soon" rather than a dead button.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Test Store key. Only read by local development builds (__DEV__): simulators
# have no store account. Release builds always use the platform key above.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
