{
  "expo": {
    "name": "Shopbook POS",
    "slug": "shopbook-pos",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shopbookpos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.shopbook.pos",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lk.shopbook.pos",
      "versionCode": 3,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel.",
          "locationAlwaysAndWhenInUsePermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel.",
          "locationAlwaysPermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB",
          "dark": {
            "backgroundColor": "#2563EB"
          }
        }
      ],
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Shopbook POS uses Bluetooth to connect with your thermal printer.",
          "alwaysUsageDescription": "Shopbook POS requires Bluetooth to print invoices in the background.",
          "protocols": ["com.shopbook.pos"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3dfd340-0c26-4a74-9dd9-062842904f76"
      }
    },
    "runtimeVersion": "1.0.0",
    "owner": "shopbook_fayaz",
    "updates": {
      "url": "https://u.expo.dev/c3dfd340-0c26-4a74-9dd9-062842904f76"
    }
  }
}
