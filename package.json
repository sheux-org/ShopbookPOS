{
  "name": "shopbook-pos-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:mobile": "pnpm --filter shopbook-pos dev",
    "dev:web": "pnpm --filter web dev",
    "dev:web:clean": "rm -rf web/.next && pnpm --filter web dev",
    "clean:web": "rm -rf web/.next",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint:mobile": "pnpm --filter shopbook-pos lint",
    "lint:web": "pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-bluetooth-classic@1.73.0-rc.17": "mobile/patches/react-native-bluetooth-classic@1.73.0-rc.17.patch"
    },
    "onlyBuiltDependencies": [
      "react-native-bluetooth-classic"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3"
  }
}
