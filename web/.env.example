# =======================================
# Shopbook POS Web - Environment Template
# =======================================
# Copy this file to .env.local and replace placeholders with your actual credentials.
# Command: cp .env.example .env.local

# Supabase Project Credentials
# Find these in Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# UploadThing Credentials for Image Uploads
# Find your API token at: https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=your-uploadthing-token-here
